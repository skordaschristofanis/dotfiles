{
  username = "chris";
  git = {
    name = "Your Name";
    email = "you@example.com";
  };
  ssh = {
    identityFile = "~/.ssh/id_ed25519";
    signingKey = "~/.ssh/id_ed25519.pub";
    allowedSignersFile = "~/.ssh/allowed_signers";
  };
  # CIFS credentials live in a separate file (mode 600), not in this Nix attrset.
  # File format:
  #   username=...
  #   password=...
  #   domain=...   # optional
  smb = {
    credentialsFile = "~/.secrets/smb-credentials";
    # Optional: uid = 1000; gid = 1000;

    # Top-level attr = mount under / ; nested attrs = map keys (/core/data, …).
    # Use device = "//host/share" for CIFS (module adds the autofs leading colon).
    # Defaults: cifs rw,vers=3.0,sec=ntlmssp + credentials/uid/gid
    #           nfs rw,nosuid,nodev,nolock,soft,vers=3
    mounts = {
      core = {
        data = {
          fstype = "cifs";
          device = "//10.50.1.2/data";
        };
        library = {
          fstype = "cifs";
          device = "//10.50.1.2/library";
        };
        media = {
          fstype = "cifs";
          device = "//10.50.1.2/media";
        };
      };
    };
  };
}
