#!/bin/sh

SESSION_DIR="$(dirname "$(readlink -f "$0")")"

# Cursor size before clients start (does not affect font DPI)
if [ -f "$SESSION_DIR/Xresources" ]; then
  xrdb -merge "$SESSION_DIR/Xresources"
fi
export XCURSOR_SIZE=24

# Apply display layout before the window manager starts
"${XDG_CONFIG_HOME:-$HOME/.config}/display/apply_monitors.sh"

# Launch ~/.config/autostart/*.desktop entries
if command -v dex-autostart >/dev/null 2>&1; then
  dex-autostart &
else
  echo "dex-autostart not found; install the dex package for autostart support" >&2
fi

exec dwm
